<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="center_vertical|end"
        android:padding="12dp"
        android:text="0"
        android:textSize="40sp" />

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:stretchColumns="*">

        <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/btn7" android:layout_height="match_parent" android:text="7" android:textSize="24sp" />
            <Button android:id="@+id/btn8" android:layout_height="match_parent" android:text="8" android:textSize="24sp" />
            <Button android:id="@+id/btn9" android:layout_height="match_parent" android:text="9" android:textSize="24sp" />
            <Button android:id="@+id/btnDiv" android:layout_height="match_parent" android:text="/" android:textSize="24sp" />
        </TableRow>

        <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/btn4" android:layout_height="match_parent" android:text="4" android:textSize="24sp" />
            <Button android:id="@+id/btn5" android:layout_height="match_parent" android:text="5" android:textSize="24sp" />
            <Button android:id="@+id/btn6" android:layout_height="match_parent" android:text="6" android:textSize="24sp" />
            <Button android:id="@+id/btnMul" android:layout_height="match_parent" android:text="*" android:textSize="24sp" />
        </TableRow>

        <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/btn1" android:layout_height="match_parent" android:text="1" android:textSize="24sp" />
            <Button android:id="@+id/btn2" android:layout_height="match_parent" android:text="2" android:textSize="24sp" />
            <Button android:id="@+id/btn3" android:layout_height="match_parent" android:text="3" android:textSize="24sp" />
            <Button android:id="@+id/btnSub" android:layout_height="match_parent" android:text="-" android:textSize="24sp" />
        </TableRow>

        <TableRow android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <Button android:id="@+id/btnC" android:layout_height="match_parent" android:text="C" android:textSize="24sp" />
            <Button android:id="@+id/btn0" android:layout_height="match_parent" android:text="0" android:textSize="24sp" />
            <Button android:id="@+id/btnEq" android:layout_height="match_parent" android:text="=" android:textSize="24sp" />
            <Button android:id="@+id/btnAdd" android:layout_height="match_parent" android:text="+" android:textSize="24sp" />
        </TableRow>
    </TableLayout>
</LinearLayout>
